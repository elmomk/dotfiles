alias mr-watch='claude --allow-dangerously-skip-permissions "Run gl-mr-watch (always show table), then gl-mr-poll. If gl-mr-poll exits 1, no further action — table was already shown. If gl-mr-poll exits 0 (actionable MRs): IMMEDIATELY fire gl-notify with the count + IIDs + first URL (notify-on-pending, before drafts finish), then launch a background Agent subagent per MR to DRAFT-ONLY: run /review-mr <IID> and write the review body to /tmp/mr-review-<IID>.md. DO NOT post. DO NOT call gl-mr comment. DO NOT call gl-mr-watch mark. When all draft agents finish, surface each draft inline in the conversation and ASK the user to approve/edit/skip before posting. Only after explicit user approval per MR: GL_MR_ALLOW_POST=1 gl-mr comment <IID> - <project> with the (possibly edited) body, then gl-mr-watch mark <IID> <verdict>, then gl-notify confirming the post. Auto-DRAFT all NEW and UPDATED MRs without asking; auto-POST is forbidden. Skip any MR whose author is in the blacklist array from ~/.mr-review-state.json. Stale MRs (>1 week) filtered by gl-mr-poll. State: ~/.mr-review-state.json. Review DB: ~/.mr-reviews.json. This is a one-shot manual trigger — no CronCreate, no auto-poll."'
alias issue-engineer='claude --allow-dangerously-skip-permissions "Run gl-issue-watch (always show table), then set up a CronCreate with '"'"'*/5 * * * *'"'"'. Each tick: run gl-issue-watch (show table), then gl-issue-poll. If gl-issue-poll exits 0 (actionable issues), launch a background Agent subagent per issue (with isolation: worktree) to: read the full issue via glab issue view <IID>, ALWAYS enter /plan mode first to design the implementation approach then auto-accept the plan, create a worktree branch feat/issue-<IID>-<slug>, implement the changes following CONVENTIONS.md, commit with resolves #<IID>, push the branch, create MR via gl-mr create master with Closes #<IID> in body, add momoyang as reviewer via glab mr update <MR_IID> --reviewer momoyang, leave a note on the original issue referencing the MR via glab issue note <IID> -m '"'"'Automated implementation submitted: MR !<MR_IID> — please review.'"'"', record via gl-issue-watch mark <IID> mr_created <MR_IID>, notify via gl-notify. If gl-issue-poll exits 1, no further action — table was already shown. Auto-implement all NEW issues without asking. Skip any issue whose author is in the blacklist array from ~/.issue-engineer-state.json. If issue description is too vague, mark as skipped. State: ~/.issue-engineer-state.json. glab path: glab."'
alias t-claude="tmx claude --teammate-mode tmux"
tmx() {
  # Get the name of the current working directory
  local session_name=$(basename "$PWD")

  # 1. Create a new detached session with the directory name
  # 2. Send the command (all arguments passed to the function)
  # 3. 'C-m' is the "Enter" key
  # 4. Attach to the newly created session
  tmux new-session -d -s "$session_name" && \
  tmux send-keys -t "$session_name" "$*" C-m && \
  tmux attach-session -t "$session_name"
}

worktree-clean() {
git worktree list --porcelain | grep '^worktree ' | cut -d ' ' -f 2 | xargs -I {} sh -c 'MAIN=$(git rev-parse --show-toplevel); if [ "{}" != "$MAIN" ]; then cd {}; if [ -z "$(git status --porcelain)" ]; then echo "🧹 Removing: {}"; git worktree remove "{}"; else echo "❌ DIRTY: {}"; fi; fi'
}

worktree-check() {
  git worktree list --porcelain | grep '^worktree ' | cut -d ' ' -f 2 | xargs -I {} sh -c 'cd {}; if [ -n "$(git status --porcelain)" ]; then echo "❌ DIRTY: {}"; else echo "✅ CLEAN: {}"; fi'
}
decrypt() {
    cd $(git rev-parse --show-toplevel) || return 1
    # If `gpg-deploy --ephemeral` set up a tmpfs keyring, reveal through it.
    local eph="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gnupg-ephemeral"
    [[ -d $eph ]] && export GNUPGHOME="$eph"
    # Self-heal on a fresh box (e.g. dev-server): if git-secret or any secret key
    # is missing, run the `gpg-deploy` bootstrap first (no-op once set up). It
    # installs git-secret and imports the deploy key from the Bitwarden
    # 'gpg-deploy-key' note. The key passphrase is prompted interactively at
    # reveal — by design it is NOT in the vault.
    if command -v gpg-deploy >/dev/null 2>&1 \
       && { ! command -v git-secret >/dev/null 2>&1 || [[ -z "$(gpg --list-secret-keys 2>/dev/null)" ]]; }; then
        gpg-deploy || { cd -; return 1; }
    fi
    export GPG_TTY=$(tty)   # pinentry needs the controlling terminal
    git secret reveal -vfF
    cd -
}

encrypt(){
    cd $(git rev-parse --show-toplevel) || return 1
    git secret hide -vmF
    cd -
}

# Encrypt with diff + explicit confirmation (recommended over `encrypt`).
# Decrypts current ciphertext via `git secret cat`, diffs against working-tree
# plaintext, prints summary + diffs, asks before re-encrypting. Catches the
# cross-contamination class of mistakes before push.
encrypt-confirm() {
    cd $(git rev-parse --show-toplevel) || return 1
    bash scripts/git-secret-hide-confirm.sh "$@"
    cd -
}

# ── Bitwarden session secrets (interactive: unlock once per login) ───────────
#   bwu : unlock the vault and load this session's shell tokens.
#   Source of truth = Bitwarden cloud (zero-knowledge — nothing authoritative on
#   disk). Two Secure Notes hold the JSON blobs: `secrets-json` (→ ~/.secrets.json)
#   and `work-json` (→ ~/.work.json). bwu always exports tokens into the shell
#   (GITLAB_*, JIRA_API_TOKEN, INFRACOST_API_KEY).
#   On-disk fallback is opt-in BY FILE EXISTENCE: a ~/.secrets.json / ~/.work.json
#   that already exists is re-synced 0600 from the vault for non-interactive jobs
#   (gl-mr-watch, gl-issue-watch, mr-review-status, cron) that can't read shell
#   env vars; if a file is absent it is NOT created (100% Bitwarden on that box).
#   Opt a box in:  touch ~/.secrets.json && bwu   — opt out:  rm ~/.secrets.json
_bw_cache_sync() {   # <json-string> <dest-path> → echoes a status word
  # NB: locals are underscore-prefixed to avoid colliding with the caller's
  # `json` under zsh dynamic scoping (a same-named local silently mangles it).
  local _j="$1" _path="$2" _tmp
  [[ -f $_path ]] || { print -r -- "skipped"; return 0; }
  [[ -n $_j ]]    || { print -r -- "FAILED(empty-note;kept-old)"; return 1; }
  if ! print -r -- "$_j" | jq -e . >/dev/null 2>&1; then
    print -r -- "FAILED(invalid-note;kept-old)"; return 1
  fi
  _tmp="$(mktemp)"; ( umask 077; print -r -- "$_j" > "$_tmp" )
  if chmod 600 "$_tmp" && mv -f "$_tmp" "$_path"; then print -r -- "refreshed"
  else rm -f "$_tmp"; print -r -- "FAILED(write)"; fi
}
# Store a secret in the kernel keyring (user keyring @u) so every session and
# consumer of this UID can read it without re-unlocking the vault. The value is
# piped via stdin (never in argv), lives in kernel memory only (nothing on disk),
# and is wiped on reboot. Perms 0x3f3f0000 = possessor+user full, group/other none.
_bw_kr_put() {  # <key-name> <value>
  command -v keyctl >/dev/null 2>&1 || return 0
  [[ -n $2 ]] || return 0
  local _id
  _id="$(print -rn -- "$2" | keyctl padd user "$1" @u 2>/dev/null)" || return 0
  keyctl setperm "$_id" 0x3f3f0000 >/dev/null 2>&1
}
# Read a `user` key from the user keyring; print payload, empty on miss.
_bw_kr_get() {  # <key-name>
  command -v keyctl >/dev/null 2>&1 || return 0
  local _id; _id="$(keyctl search @u user "$1" 2>/dev/null)" || return 0
  keyctl print "$_id" 2>/dev/null || return 0
}
bwu() {
  local s json wjson sc wc mrg mru acid asite
  # A stale BW_SESSION already in the env makes a fresh `bw unlock` hand back an
  # EMPTY session (with exit 0!), which then poisons every `bw get`. Clear it first.
  unset BW_SESSION
  s="$(bw unlock --raw)" || return 1
  if [[ -z $s ]]; then
    print -P "%F{red}✗%f bw unlock returned an empty session (wrong password, or run \`bw lock\` and retry)"
    return 1
  fi
  export BW_SESSION="$s"

  # No 2>/dev/null here: if the read fails we want bw's real error, not a silent
  # "missing" verdict that sends you hunting the wrong thing.
  json="$(bw get notes secrets-json)"
  if [[ -z $json ]] || ! print -r -- "$json" | jq -e . >/dev/null 2>&1; then
    print -P "%F{red}✗%f could not read Secure Note 'secrets-json' (empty or not valid JSON)"
    return 1
  fi

  # Export env from the secrets blob (reuses the gl-* scripts' GITLAB_* convention).
  eval "$(print -r -- "$json" | jq -r '.gitlab // {} | to_entries[] | "export GITLAB_\(.key|ascii_upcase)=\(.value|@sh)"')"
  export JIRA_API_TOKEN="$(print -r -- "$json" | jq -r '.jira.api_token // empty')"
  export INFRACOST_API_KEY="$(print -r -- "$json" | jq -r '.infra_cost_api_token.token // empty')"

  wjson="$(bw get notes work-json 2>/dev/null)"
  mrg="$(print -r -- "$wjson" | jq -r '.mr_review.group // empty' 2>/dev/null)"
  mru="$(print -r -- "$wjson" | jq -r '.mr_review.users // empty' 2>/dev/null)"
  # Atlassian tenant identifiers (non-secret PI) — kept out of every repo; mr-board
  # reads them from here (env → keyring → ~/.work.json), never hardcoded.
  acid="$(print -r -- "$wjson" | jq -r '.atlassian.cloud_id // empty' 2>/dev/null)"
  asite="$(print -r -- "$wjson" | jq -r '.atlassian.site // empty' 2>/dev/null)"

  # Primary store: kernel keyring (@u) — read by every session/consumer of this
  # UID via gl-load-creds, in kernel memory only, wiped on reboot.
  _bw_kr_put gl:host         "$GITLAB_HOST"
  _bw_kr_put gl:token        "$GITLAB_TOKEN"
  _bw_kr_put mr:group        "$mrg"
  _bw_kr_put mr:users        "$mru"
  _bw_kr_put jira:token      "$JIRA_API_TOKEN"
  _bw_kr_put infracost:token "$INFRACOST_API_KEY"
  _bw_kr_put atlassian:cloud_id "$acid"
  _bw_kr_put atlassian:site     "$asite"
  # Full secrets blob (compact JSON) for generic consumers like ~/work/.envrc,
  # which export every scalar rather than a fixed set of keys.
  _bw_kr_put secrets:json    "$(print -r -- "$json" | jq -c . 2>/dev/null)"

  # Re-sync the opt-in on-disk caches (no-op where the file is absent).
  sc="$(_bw_cache_sync "$json"  "$HOME/.secrets.json")"
  wc="$(_bw_cache_sync "$wjson" "$HOME/.work.json")"

  # Materialise mr-board's runtime config from the vault (opt-in by directory
  # existence, like the caches above). cloud_id/site are non-secret tenant
  # identifiers kept out of every repo; jira_key_re is a local preference we
  # preserve. Lets mr-board stay config-file-driven with the vault as SoT.
  if [[ -d "$HOME/.config/mr-board" && -n $acid ]]; then
    local _jkr
    _jkr="$(grep -E '^jira_key_re' "$HOME/.config/mr-board/config.toml" 2>/dev/null)"
    [[ -z $_jkr ]] && _jkr="jira_key_re = '(?i)\\b(PE-\\d+)\\b'"
    printf '# Regenerated by bwu from Bitwarden work-json .atlassian — do not commit.\n# cloud_id/site are non-secret tenant identifiers; GitLab/Jira tokens come via bwu.\nsite = "%s"\ncloud_id = "%s"\n%s\n' \
      "$asite" "$acid" "$_jkr" > "$HOME/.config/mr-board/config.toml"
  fi

  # Point glab at the internal instance over http (matching the gl-* scripts'
  # http://$GITLAB_HOST). Protocol only — the token stays in the keyring/env, so
  # nothing secret is written to glab's on-disk config. No hardcoded host.
  if command -v glab >/dev/null 2>&1 && [[ -n $GITLAB_HOST ]]; then
    glab config set api_protocol http --host "$GITLAB_HOST" >/dev/null 2>&1
    glab config set api_host "$GITLAB_HOST" --host "$GITLAB_HOST" >/dev/null 2>&1
  fi

  local kr; command -v keyctl >/dev/null 2>&1 && kr="keyring" || kr="keyring(no keyctl)"
  if [[ -n $GITLAB_TOKEN ]]; then
    print -P "%F{green}✓%f vault unlocked — tokens loaded → $kr; file cache: secrets=$sc work=$wc"
  else
    print -P "%F{yellow}✓%f vault unlocked — .gitlab.token empty in note; file cache: secrets=$sc work=$wc"
  fi
  bw_keyring_hydrate   # make this shell match a freshly-spawned one
}

# Hydrate this shell's env from the kernel keyring populated by `bwu`. Runs at
# shell init (below) so every new pane/session after a single `bwu` per boot has
# the tokens, with zero plaintext at rest. Env already set (direnv) is kept.
# Key names are the shared contract with `bwu` / `gl-load-creds`.
bw_keyring_hydrate() {
  command -v keyctl >/dev/null 2>&1 || return 0
  : "${GITLAB_HOST:=$(_bw_kr_get gl:host)}";             [[ -n $GITLAB_HOST ]]        && export GITLAB_HOST
  : "${GITLAB_TOKEN:=$(_bw_kr_get gl:token)}";           [[ -n $GITLAB_TOKEN ]]       && export GITLAB_TOKEN
  : "${JIRA_API_TOKEN:=$(_bw_kr_get jira:token)}";       [[ -n $JIRA_API_TOKEN ]]     && export JIRA_API_TOKEN
  : "${INFRACOST_API_KEY:=$(_bw_kr_get infracost:token)}"; [[ -n $INFRACOST_API_KEY ]] && export INFRACOST_API_KEY
}
bw_keyring_hydrate

# Install local git pre-commit hooks: vault plaintext guard + mapping.cfg
# collision lint. One-shot install per worktree.
install-hooks() {
    cd $(git rev-parse --show-toplevel) || return 1
    just install-hooks
    cd -
}

switch() {
    # 1. Get Git Root
    local git_root
    if ! git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        echo "Error: Not inside a git repository."
        return 1
    fi

    local current_dir="$(pwd)"
    
    # 2. Define your environment containers (Order matters for default fallback)
    local candidates=("infra" "overlays")
    local base_dir_name=""

    # 3. Smart Scope Detection: check if we are *inside* a specific container
    for cand in "${candidates[@]}"; do
        if [[ "$current_dir" == "$git_root/$cand"* ]]; then
            base_dir_name="$cand"
            break
        fi
    done

    # 4. Fallback: If at repo root, default to the first candidate that exists
    if [ -z "$base_dir_name" ]; then
        for cand in "${candidates[@]}"; do
            if [ -d "$git_root/$cand" ]; then
                base_dir_name="$cand"
                break
            fi
        done
    fi

    if [ -z "$base_dir_name" ]; then
        echo "Error: Could not find 'infra' or 'overlays' directories."
        return 1
    fi

    local base_path="$git_root/$base_dir_name"

    # 5. Select Target Environment (Scoped to the detected base directory)
    local envs
    envs=$(find "$base_path" -mindepth 1 -maxdepth 1 -type d -not -name '.*' -exec basename {} \;)
    
    local target_env
    target_env=$(echo "$envs" | fzf --height=~50% --header="Switching inside: $base_dir_name")

    if [ -z "$target_env" ]; then
        return 0
    fi

    # 6. Construct Target Path (Preserve subdirectory depth)
    local target_full_path

    if [[ "$current_dir" == "$base_path"* ]]; then
        # We are inside the structure (e.g. .../overlays/dev/clusters)
        
        # Strip the base path to get relative path (e.g. dev/clusters)
        local rel_path="${current_dir#$base_path/}"
        
        # Extract the current environment name (the first segment, e.g. dev)
        local current_env_segment="${rel_path%%/*}"
        
        # Extract the rest of the path (e.g. /clusters)
        # If we are at the env root, this might be empty
        local rest_of_path="${rel_path#$current_env_segment}"
        
        target_full_path="$base_path/$target_env$rest_of_path"
    else
        # We are outside (e.g. at git root), just go to the env root
        target_full_path="$base_path/$target_env"
    fi

    # 7. Execute Switch
    if [ -d "$target_full_path" ]; then
        cd "$target_full_path" || return 1
    else
        echo "Path '$target_full_path' does not exist."
        echo "Falling back to environment root..."
        cd "$base_path/$target_env" || return 1
    fi

    echo "Switched to: $(pwd)"
}


home() {
  pwd
  echo "cd ->"
  cd `git rev-parse --show-toplevel`
  pwd
}
#clamav
scandir() {
  # check first argument
  # if empty, scan current directory
  # if not empty, scan that directory
  RECURSIVE=""
  if [ -z "$1" ]
  then
    location=$(pwd)
  else
    location=$1
  fi
  # check second argument equals r, then scan recursively
  if [ "$2" = "r" ]
  then
    echo "recursive"
    RECURSIVE="-r"
  fi
    echo "start scanning $location"
    echo "docker run -it --rm \
    --mount type=bind,source=$location,target=/scandir \
    clamav/clamav:unstable \
    clamscan /scandir $RECURSIVE"
    docker run -it --rm \
    --mount type=bind,source=$location,target=/scandir \
    clamav/clamav:unstable \
    clamscan /scandir $RECURSIVE
}

