[Unit]
Description=Wipe git-secret revealed plaintext + ephemeral GPG key on session/shutdown
Documentation=man:git-secret(7)

# A oneshot that does nothing on start but, because RemainAfterExit=yes, stays
# "active" for the whole session. Its ExecStop therefore fires exactly when the
# user manager stops the unit — i.e. on logout, and on system shutdown when the
# user lingers (see install note below). That is our "before shutdown" hook.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=%h/bin/git-secret-wipe
TimeoutStopSec=30

[Install]
WantedBy=default.target

# Install (after `stow systemd`):
#   systemctl --user daemon-reload
#   systemctl --user enable --now git-secret-wipe.service
# To also fire on full shutdown when you are NOT interactively logged in, let the
# user manager persist across logout:
#   loginctl enable-linger "$USER"
