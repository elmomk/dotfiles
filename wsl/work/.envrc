# Secrets: source of truth is Bitwarden. Prefer the kernel keyring populated by
# `bwu` (kernel memory only — zero plaintext at rest); then the legacy on-disk
# 0600 cache if a box opted into it; then a live vault pull when unlocked.
# Either way the JSON lives only in this variable and is never written to disk.
SECRETS_JSON="$(
  if command -v keyctl >/dev/null 2>&1 && _id=$(keyctl search @u user secrets:json 2>/dev/null); then
    keyctl print "$_id" 2>/dev/null
  elif [ -f "$HOME/.secrets.json" ]; then
    cat "$HOME/.secrets.json"
  elif [ -z "${GITLAB_TOKEN:-}" ] && [ -n "${BW_SESSION:-}" ] && command -v bw >/dev/null 2>&1; then
    # No keyring/cache: pull live, but only when the vault is unlocked
    # (BW_SESSION set) and `bwu` hasn't already exported the tokens. This
    # avoids a per-`cd` network call and a hang on a locked vault.
    bw get notes secrets-json 2>/dev/null
  fi
)"

if [ -n "$SECRETS_JSON" ] && command -v jq >/dev/null 2>&1 \
   && printf '%s' "$SECRETS_JSON" | jq -e . >/dev/null 2>&1; then
  eval "$(printf '%s' "$SECRETS_JSON" | jq -r '
    paths(scalars) as $p |
    [($p | map(tostring | ascii_upcase) | join("_")), getpath($p)] |
    "export \(.[0])=\(.[1] | @sh)"
  ')"
fi
unset SECRETS_JSON

if command -v jira >/dev/null 2>&1 && [ -n "${JIRA_TOKEN:-}" ]; then
  export ACTIVE_SPRINT_ID=$(jira sprint list --state=active --plain --table=false | cut -f1 | grep -v ID | head -n 1 2>/dev/null)
fi
