#!/usr/bin/env bash
# tmux-claude-name — recap a tmux window's Claude Code session and rename the
# window to a terse 1-3 word keyword label, using a headless `claude -p` call.
#
# Usage:
#   tmux-claude-name [target]   # name one window (default: current)
#   tmux-claude-name -a         # name every window in the attached session
#
# For windows that aren't running a Claude session it falls back to the pane's
# directory basename (same logic as auto-name.sh). Renamed windows are made
# sticky (automatic-rename off) so the label survives later pane-title changes.

set -u

CLAUDE_BIN="$(command -v claude || echo "$HOME/.local/bin/claude")"
MODEL="${TMUX_CLAUDE_NAME_MODEL:-haiku}"
SCROLL_LINES="${TMUX_CLAUDE_NAME_LINES:-160}"
MAX_LEN=24
MAX_WORDS=3

# -a fan-out limit. Parallel `claude -p` cold-starts contend with each other
# (startup/update locks) and all crawl toward the 90s timeout, so the WSL
# laptop runs strictly serial; the dev-server takes 10.
# Override with TMUX_CLAUDE_NAME_JOBS.
if [ -n "${TMUX_CLAUDE_NAME_JOBS:-}" ]; then
    JOBS="$TMUX_CLAUDE_NAME_JOBS"
elif grep -qi microsoft /proc/version 2>/dev/null; then
    JOBS=1
else
    JOBS=10
fi

PROMPT='You are labeling a tmux window that hosts a Claude Code coding session. Below is the visible terminal scrollback. Reply with ONLY a terse window label of AT MOST 3 words (max 24 chars) describing what this session is working on — e.g. "publish race fix", "pi-extensions docs". No quotes, no punctuation, no explanation. If you genuinely cannot tell, reply with the single word: shell'

sanitize() {
    # The pane scrollback is UNTRUSTED input to the model, and the result becomes
    # a tmux window name — which tmux expands as a format string in the status
    # line. A name containing #(...) / #{...} would execute. So hard-restrict the
    # output to a safe charset (drops #, $, backtick, parens, ; etc.), collapse
    # to one line, and cap the length.
    tr '\n' ' ' \
    | tr -cd 'A-Za-z0-9 ._/-' \
    | tr -s ' ' \
    | sed -e 's/^[[:space:]]*//; s/[[:space:]]*$//' \
    | cut -d' ' -f1-"$MAX_WORDS" \
    | cut -c1-"$MAX_LEN" \
    | sed -e 's/[[:space:]]*$//'
}

ask_claude() {
    # One headless naming call. Echoes a sanitized label, or nothing if the run
    # failed. `claude -p` reports failures as ordinary stdout prose ("Execution
    # error", "Reached max turn", "API Error: ...") and can still exit 0 — those
    # strings pass sanitize() untouched and would otherwise become the window
    # name, so match them explicitly rather than trusting the exit status alone.
    local scroll="$1" raw rc label
    raw=$(printf '%s\n\n---\n%s\n' "$PROMPT" "$scroll" \
        | timeout 90 "$CLAUDE_BIN" -p --model "$MODEL" --allowedTools '' 2>/dev/null)
    rc=$?
    [ "$rc" -eq 0 ] || return 0
    label=$(printf '%s' "$raw" | sanitize)
    printf '%s' "$label" | grep -qiE \
        '^(execution error|api error|reached max|invalid api|credit balance|prompt is too long|request timed out)' \
        && return 0
    printf '%s' "$label"
}

name_window() {
    local w="$1" path cmd scroll name
    path=$(tmux display-message -t "$w" -p '#{pane_current_path}' 2>/dev/null)
    scroll=$(tmux capture-pane -t "$w" -p -S -"$SCROLL_LINES" 2>/dev/null)

    # Is this a Claude Code session pane? Match its statusline / banner markers.
    if printf '%s' "$scroll" | grep -qE 'auto mode|Claude Code v|\(1M context\)|ctx: [0-9]'; then
        # --allowedTools '' disables all tools: the naming task needs none, and
        # it removes any tool-execution path from injected pane content.
        # One retry: the failures are transient (cold start under -a fan-out,
        # API blips), and the fallback below is only worth taking after both.
        name=$(ask_claude "$scroll")
        [ -z "$name" ] && name=$(ask_claude "$scroll")
    fi

    # Fallback: directory basename (mirrors auto-name.sh). Track whether we got a
    # real Claude-derived label vs. just the basename, so we only make REAL labels
    # sticky. Stickying the generic basename freezes a window there with
    # automatic-rename off — and a Claude session the model simply hadn't detected
    # yet (cold start / timeout) would never recover its task title.
    local got_label=1
    if [ -z "${name:-}" ] || [ "$name" = "shell" ]; then
        got_label=0
        name=$(basename "$path" 2>/dev/null)
        [ "$path" = "$HOME" ] && name="~"
    fi
    [ -z "$name" ] && return 0

    tmux rename-window -t "$w" "$name"
    if [ "$got_label" = 1 ]; then
        # Real label: make it sticky so it survives later pane-title changes.
        tmux set-window-option -t "$w" automatic-rename off 2>/dev/null
        tmux set-option -wt "$w" @auto-name off 2>/dev/null
    else
        # Basename fallback only: leave automatic-rename ON (non-sticky) so the
        # window keeps tracking pane_title and isn't frozen at a generic name.
        tmux set-window-option -t "$w" automatic-rename on 2>/dev/null
        tmux set-option -wu -t "$w" @auto-name 2>/dev/null
    fi
    printf '%s -> %s\n' "$w" "$name"
}

# --- activity indicator -------------------------------------------------------
# Mirror "naming in progress" into a tmux user option (@cc_naming) so the status
# bar can show it. Every unit of work — a single run, or each window of an -a
# run — holds its own token file, so the option live-counts the windows still
# being named (N → … → 1 → cleared). Background children do NOT inherit the
# parent's EXIT trap, so each child claims its token + trap itself.
LOCKDIR="${TMPDIR:-/tmp}/tmux-claude-name"
mkdir -p "$LOCKDIR" 2>/dev/null
find "$LOCKDIR" -type f -mmin +5 -delete 2>/dev/null  # sweep tokens orphaned by SIGKILL

refresh_flag() {
    local n
    n=$(find "$LOCKDIR" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "${n:-0}" -gt 0 ]; then tmux set -g @cc_naming "$n" 2>/dev/null
    else tmux set -gu @cc_naming 2>/dev/null; fi
    tmux refresh-client -S 2>/dev/null || true
}
cleanup() { rm -f "$TOKEN" 2>/dev/null; refresh_flag; }
claim()   { TOKEN="$LOCKDIR/$1"; : > "$TOKEN"; trap cleanup EXIT INT TERM; refresh_flag; }

if [ "${1:-}" = "-a" ]; then
    sess=$(tmux display-message -p '#{session_name}')
    while IFS= read -r idx; do
        # throttle: keep at most $JOBS windows naming at once
        while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n 2>/dev/null || sleep 0.2; done
        ( claim "$$-w$idx"; name_window "${sess}:${idx}" ) &
    done < <(tmux list-windows -t "$sess" -F '#{window_index}')
    wait
else
    claim "$$"
    target="${1:-$(tmux display-message -p '#{session_name}:#{window_index}')}"
    name_window "$target"
fi
