#!/usr/bin/env bash
# tmux-claude-name — recap a tmux window's Claude Code session and rename the
# window to a terse 1-3 word keyword label, using a headless `claude -p` call.
#
# Usage:
#   tmux-claude-name [target]   # name one window (default: current)
#   tmux-claude-name -a         # name every window in the attached session
#
# For windows that aren't running a Claude session it falls back to the pane's
# directory basename (same logic as auto-name.sh). Renamed windows are made
# sticky (automatic-rename off) so the label survives later pane-title changes.

set -u

CLAUDE_BIN="$(command -v claude || echo "$HOME/.local/bin/claude")"
MODEL="${TMUX_CLAUDE_NAME_MODEL:-haiku}"
SCROLL_LINES="${TMUX_CLAUDE_NAME_LINES:-160}"
MAX_LEN=24

PROMPT='You are labeling a tmux window that hosts a Claude Code coding session. Below is the visible terminal scrollback. Reply with ONLY a terse 1-3 word window label (max 24 chars) describing what this session is working on — e.g. "publish race fix", "pi-extensions docs". No quotes, no punctuation, no explanation. If you genuinely cannot tell, reply with the single word: shell'

sanitize() {
    # single line, strip wrapping quotes/backticks, trim, collapse spaces, cap length
    sed -e 's/^[[:space:]]*//; s/[[:space:]]*$//' \
        -e 's/^["'"'"'`]//; s/["'"'"'`]$//' \
    | tr '\n' ' ' \
    | tr -s ' ' \
    | cut -c1-"$MAX_LEN" \
    | sed -e 's/[[:space:]]*$//'
}

name_window() {
    local w="$1" path cmd scroll name
    path=$(tmux display-message -t "$w" -p '#{pane_current_path}' 2>/dev/null)
    scroll=$(tmux capture-pane -t "$w" -p -S -"$SCROLL_LINES" 2>/dev/null)

    # Is this a Claude Code session pane? Match its statusline / banner markers.
    if printf '%s' "$scroll" | grep -qE 'auto mode|Claude Code v|\(1M context\)|ctx: [0-9]'; then
        name=$(printf '%s\n\n---\n%s\n' "$PROMPT" "$scroll" \
            | timeout 90 "$CLAUDE_BIN" -p --model "$MODEL" 2>/dev/null | sanitize)
    fi

    # Fallback: directory basename (mirrors auto-name.sh)
    if [ -z "${name:-}" ] || [ "$name" = "shell" ]; then
        name=$(basename "$path" 2>/dev/null)
        [ "$path" = "$HOME" ] && name="~"
    fi
    [ -z "$name" ] && return 0

    tmux rename-window -t "$w" "$name"
    tmux set-window-option -t "$w" automatic-rename off 2>/dev/null
    tmux set-option -wt "$w" @auto-name off 2>/dev/null
    printf '%s -> %s\n' "$w" "$name"
}

if [ "${1:-}" = "-a" ]; then
    sess=$(tmux display-message -p '#{session_name}')
    while IFS= read -r idx; do
        name_window "${sess}:${idx}" &
    done < <(tmux list-windows -t "$sess" -F '#{window_index}')
    wait
else
    target="${1:-$(tmux display-message -p '#{session_name}:#{window_index}')}"
    name_window "$target"
fi
