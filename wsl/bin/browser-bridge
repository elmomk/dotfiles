#!/usr/bin/env bash
# browser-bridge — open URLs sent from a remote host in the LOCAL browser.
#
# Run this on the machine that HAS the browser (e.g. your WSL laptop). It listens
# on a loopback port; each line it receives is treated as a URL and opened via
# `open-url`. Pair it with, on the remote dev-server:
#   - SSH:  RemoteForward 127.0.0.1:8765 127.0.0.1:8765
#           (or `gcloud compute ssh … -- -R 127.0.0.1:8765:127.0.0.1:8765`)
#   - open-url, which sends URLs to 127.0.0.1:8765 when it's on a remote box.
#
# So: dev-server `open-url URL` → loopback:8765 → (reverse tunnel) → laptop:8765
#     → browser-bridge → open-url → Windows browser.
#
# Usage:
#   browser-bridge            # start the listener (singleton)
#   browser-bridge --handle   # internal: open one URL read from stdin
set -u

PORT="${BROWSER_BRIDGE_PORT:-8765}"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/browser-bridge.$PORT.lock"

# Sync-on-view: when an incoming URL points at the LOCAL teach-me/daily server,
# first pull the dev-server's freshly-authored docs into the local library so
# the page is present before the browser loads it. The server is laptop-only;
# the dev box is a contributor. Additive (--update, no --delete): the dev box
# only adds/refreshes files, never removes or clobbers a newer local copy — safe
# when both machines author docs. Topic nav blocks live in the per-machine
# zensical.toml (not under docs/), so the dev toml is pulled aside and its
# tutorials block merged in — without this, dev-box topics never reach the left
# nav. Both nav blocks regenerated, then the site is rebuilt, because the server
# serves site/ from disk. Target = the same dev_server config the `dev-server`
# wrapper uses (env or the work-json cache); never the socket input.
TEACHME_PORT="${TEACHME_PORT:-8042}"
TEACHME_HOME="${TEACHME_HOME:-$HOME/teach-me}"
WORK_JSON="${WORK_JSON:-$HOME/.work.json}"

log() { printf '[browser-bridge] %s\n' "$*" >&2; }

_wj() { [[ -f "$WORK_JSON" ]] && jq -r "$1 // empty" "$WORK_JSON" 2>/dev/null || true; }

# Pull the dev-server's teach-me docs into the local library (one-way, additive).
# Best-effort: any failure logs and returns 0 so the browser still opens. Paths
# are hardcoded; the only inputs are the dev_server target from env/work-json.
sync_teach_me() {
  command -v rsync >/dev/null 2>&1 && command -v gcloud >/dev/null 2>&1 || return 0
  command -v gcloud-rsh >/dev/null 2>&1 || { log "teach-me sync skipped (gcloud-rsh not on PATH)"; return 0; }
  local zone inst proj
  zone="${DEV_SERVER_ZONE:-$(_wj '.dev_server.zone')}"
  inst="${DEV_SERVER_INSTANCE:-$(_wj '.dev_server.instance')}"
  proj="${DEV_SERVER_PROJECT:-$(_wj '.dev_server.project')}"
  [[ -n "$zone" && -n "$inst" && -n "$proj" ]] || { log "teach-me sync skipped (no dev_server target)"; return 0; }
  mkdir -p "$TEACHME_HOME/library/docs"
  log "syncing teach-me docs from $inst …"
  if timeout 90 rsync -az --update --exclude='.git' \
       -e "gcloud-rsh $zone $proj" \
       "$inst:teach-me/library/docs/" "$TEACHME_HOME/library/docs/" >/dev/null 2>&1; then
    log "teach-me docs synced"
    # Topic nav blocks live in the dev box's zensical.toml, not under docs/ —
    # pull that toml aside and merge its tutorials block into the local one
    # (keyed by topic slug; local-only topics survive).
    local mg
    if timeout 30 rsync -az -e "gcloud-rsh $zone $proj" \
         "$inst:teach-me/library/zensical.toml" "$TEACHME_HOME/library/.dev-zensical.toml" >/dev/null 2>&1; then
      for mg in "$HOME/.claude/skills/teach-me/scripts/sync_topics_nav.py" \
                "$HOME/work/git/configs/.agents/skills/teach-me/scripts/sync_topics_nav.py"; do
        [[ -f "$mg" ]] && command -v python3 >/dev/null 2>&1 || continue
        TEACHME_HOME="$TEACHME_HOME" python3 "$mg" "$TEACHME_HOME/library/.dev-zensical.toml" >/dev/null 2>&1 \
          && log "topics nav merged" || log "topics nav merge skipped"
        break
      done
    else
      log "dev zensical.toml pull failed (topic nav may lag)"
    fi
    # Regenerate the Daily nav from the now-present docs/daily/*.md, else synced
    # dates build but don't appear in the nav. Best-effort; the script honors
    # $TEACHME_HOME and no-ops if the daily markers aren't in the local toml.
    local nav
    for nav in "$HOME/.claude/skills/daily/scripts/sync_daily_nav.py" \
               "$HOME/work/git/configs/.agents/skills/daily/scripts/sync_daily_nav.py"; do
      [[ -f "$nav" ]] && command -v python3 >/dev/null 2>&1 || continue
      TEACHME_HOME="$TEACHME_HOME" python3 "$nav" >/dev/null 2>&1 \
        && log "daily nav regenerated" || log "daily nav regen skipped"
      break
    done
    # The library server serves site/ straight from disk (no watcher), so build
    # now — the new pages and nav must be in site/ before the browser loads.
    if command -v uv >/dev/null 2>&1 && [[ -f "$TEACHME_HOME/library/zensical.toml" ]]; then
      (cd "$TEACHME_HOME/library" && timeout 120 uv run zensical build >/dev/null 2>&1) \
        && log "library rebuilt" || log "library build failed (pages may be stale)"
    fi
  else
    log "teach-me sync failed/timed out (opening anyway)"
  fi
}

# Read one URL from stdin, sanity-check it, open it locally. Only http(s) and no
# shell metacharacters — this input arrives over a socket, so never eval it.
handle() {
  local url
  IFS= read -r url || return 0
  url="${url%$'\r'}"
  if [[ "$url" =~ ^https?://[^[:space:]\'\"\`\$\;\|\&\<\>]+$ ]]; then
    # If it's the local teach-me/daily server, pull dev-server docs first.
    if [[ "$url" =~ ^https?://(127\.0\.0\.1|localhost):${TEACHME_PORT}([/?#]|$) ]]; then
      sync_teach_me
    fi
    log "open $url"
    open-url "$url" >/dev/null 2>&1 || log "open-url failed: $url"
  else
    log "ignored (not a clean URL): $url"
  fi
}

if [[ "${1:-}" == --handle ]]; then
  handle
  exit 0
fi

# Singleton: a second invocation just exits rather than fighting for the port.
exec 9>"$LOCK" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { log "already running (port $PORT)"; exit 0; }
fi

self="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
log "listening on 127.0.0.1:$PORT"

if command -v socat >/dev/null 2>&1; then
  exec socat "TCP-LISTEN:$PORT,bind=127.0.0.1,reuseaddr,fork" "SYSTEM:$self --handle"
elif command -v ncat >/dev/null 2>&1; then
  while :; do ncat -l 127.0.0.1 "$PORT" --recv-only | "$self" --handle; done
else
  log "need 'socat' or 'ncat' (nmap-ncat) installed on this machine"
  exit 1
fi
