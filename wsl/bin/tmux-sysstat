#!/usr/bin/env bash
# Compact tmux status chips. Usage:
#   tmux-sysstat left    -> "MR(Rev):<n>  MR(Approved):<m>  MR(Chg):<k>  BRIDGE:<up|down>  BAT:<%>"
#   tmux-sysstat right   -> "W<cpu>%/<free>G  L<cpu>%/<free>G"
#   tmux-sysstat disk    -> "/:<free>G  ~:<free>G"  (root + $HOME disk free)
#   tmux-sysstat api     -> "API:<n>"  (NAT ports held toward the Claude API, counted by tmux-sysstat-api)
#
# Windows side (CPU/RAM/battery) shares one powershell.exe call, cached 4s.
# Rev/Approved/Chg counts come from one GraphQL query (cached 60s): Rev matches
# the GitLab dashboard "Review requested" tab (UNREVIEWED); Approved is open MRs
# *I authored* that are approved — mine, ready for me to merge; Chg is open MRs I
# authored that a reviewer returned with changes requested (REQUESTED_CHANGES) —
# the GitLab dashboard "Returned to you" set, mine to act on.
# BRIDGE (dev-server only) probes the browser-bridge reverse tunnel that
# open-url / the MR popup letter-keys depend on.

WIN_CACHE=/tmp/.tmux-sysstat-win
WIN_TTL=4
WSL_PREV=/tmp/.tmux-sysstat-wsl-prev
# MR counts (rev/appr/chg) — written by `tmux-sysstat --refresh-mr` from a systemd
# --user timer that CAN read the @u keyring; the `left` render only *reads* this,
# because a tmux status line runs in the tmux server's context, which can't read the
# keyring. Persistent (~/.cache, not /tmp) so a reboot shows the last-good counts
# until the timer repopulates.
MR_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-sysstat/mr-counts"

mode=${1:-right}

# Under WSL there's a Windows host (W chip) alongside the Linux side (L chip).
# On the dev-server there's no Windows host, so skip the powershell.exe probe
# and the W/BAT chips entirely — only the local CPU/mem is meaningful.
is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

# Color thresholds. Returns a tmux #[fg=...] directive based on `val`.
#   color_for <val> <yellow_threshold> <red_threshold> <direction>
#   direction = high_bad (cpu)    -> green<yellow<red
#               low_bad  (bat/ram) -> red<yellow<green
color_for() {
  local val=$1 warn=$2 danger=$3 dir=$4
  case "$dir" in
    high_bad)
      if   (( val >= danger )); then printf '#[fg=red,bold]'
      elif (( val >= warn   )); then printf '#[fg=yellow]'
      else                           printf '#[fg=green]'
      fi
      ;;
    low_bad)
      if   (( val <= danger )); then printf '#[fg=red,bold]'
      elif (( val <= warn   )); then printf '#[fg=yellow]'
      else                           printf '#[fg=green]'
      fi
      ;;
  esac
}
RESET='#[default]'

# Disk chip — free GB on a mountpoint, colored by use%.
#   disk_chip <mountpoint> <label>   -> "<label>:<avail>G"
disk_chip() {
  local mnt=$1 label=$2 use avail
  read -r use avail < <(df -P -BG "$mnt" 2>/dev/null \
    | awk 'NR==2 {u=$5; sub(/%/,"",u); a=$4; sub(/G/,"",a); print u, a}')
  printf '%s%s:%sG%s' "$(color_for "${use:-0}" 80 90 high_bad)" "$label" "${avail:-?}" "$RESET"
}

# API chip — the NAT ports this box holds toward the Claude API, as tmux-sysstat-api counts
# them from /proc/net/tcp: connections open now plus those closed in the last 120 s. That is
# what Cloud NAT budgets (64 per destination) and what a socket count misses: on 2026-09-14
# SYNs were dropped with 64 ports held while `ss` read 57. 50-59 yellow, >=60 red; "+" while
# the watcher is under 120 s old and its count is a floor; API:? when the watcher is not
# running or its file is over 15 s old, never a quieter number.
API_STATE="${TMUX_SYSSTAT_API_STATE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/tmux-sysstat/api-held}"
api_chip() {
  local at n _open warm
  if [[ -f $API_STATE ]] && read -r at n _open warm < "$API_STATE" \
      && [[ $at =~ ^[0-9]+$ && $n =~ ^[0-9]+$ ]] && (( $(date +%s) - at <= 15 )); then
    printf '%sAPI:%s%s%s' "$(color_for "$n" 50 60 high_bad)" "$n" "$([[ $warm == 1 ]] || printf '+')" "$RESET"
  else
    printf '#[fg=yellow]API:?%s' "$RESET"
  fi
}

# BRIDGE probe — health of the open-url path (dev-server → laptop browser).
# One loopback port, two failure modes:
#   refused        → no sshd RemoteForward listener (SSH session lacks the -R)
#   instant EOF    → forward exists, but the laptop-side browser-bridge is dead
#                    (sshd accepts the channel, fails to connect, closes it)
#   open + silent  → healthy (read times out with the socket still open)
bridge_state() {
  local port="${BROWSER_BRIDGE_PORT:-8765}"
  (
    exec 3<>"/dev/tcp/127.0.0.1/$port"
    IFS= read -r -t 0.3 -n 1 -u 3 _
    (( $? > 128 ))
  ) 2>/dev/null
}

# --- Windows host snapshot (CPU%, free RAM GB, battery %) — cached 4s ---
compute_win() {
  is_wsl || return 0   # no Windows host on the dev-server — leave wcpu/wfree/wbat unset
  if [[ -f $WIN_CACHE ]] && (( $(date +%s) - $(stat -c %Y "$WIN_CACHE") < WIN_TTL )); then
    read -r wcpu wfree wbat < "$WIN_CACHE"
  else
    win=$(powershell.exe -NoProfile -Command '
      $os  = Get-CimInstance Win32_OperatingSystem
      $cpu = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average
      $free = [math]::Round($os.FreePhysicalMemory/1048576, 1)
      $bat = (Get-CimInstance Win32_Battery).EstimatedChargeRemaining
      if ($null -eq $bat) { $bat = "-" }
      "$cpu $free $bat"
    ' 2>/dev/null | tr -d '\r\n')
    read -r wcpu wfree wbat <<< "$win"
    : "${wcpu:=?}" "${wfree:=?}" "${wbat:=-}"
    echo "$wcpu $wfree $wbat" > "$WIN_CACHE"
  fi
}

_MR_COUNT_QUERY='
    query {
      currentUser {
        username
        reviewRequestedMergeRequests(state: opened) {
          nodes { reviewers { nodes { username mergeRequestInteraction { reviewState } } } }
        }
        authoredMergeRequests(state: opened) {
          nodes {
            approvedBy { nodes { username } }
            reviewers { nodes { username mergeRequestInteraction { reviewState } } }
          }
        }
      }
    }'

# Fetch my three MR counts from ONE host in a single GraphQL currentUser query.
# Echoes "rev appr chg" on success, nothing on failure. Needs gl-load-creds sourced
# and glab on PATH. Shared by `left` (fallback) and --refresh-mr.
#   _fetch_mr_counts <host_id>     host_id ∈ $GITLAB_HOSTS
# The SaaS leg must scrub the internal GITLAB_TOKEN/HOST: they shadow glab's own
# per-host token and turn the call into a 401.
_fetch_mr_counts() {
  local _hid="${1:-internal}"
  if [[ "$_hid" == saas ]]; then
    env -u GITLAB_TOKEN -u GITLAB_ACCESS_TOKEN -u OAUTH_TOKEN -u GITLAB_HOST \
      glab api graphql --hostname "$GITLAB_SAAS_HOST" -f query="$_MR_COUNT_QUERY" 2>/dev/null
  else
    GITLAB_HOST="$GITLAB_HOST" glab api graphql -f query="$_MR_COUNT_QUERY" 2>/dev/null
  fi | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)['data']['currentUser']
    me = data['username']
    # Rev: open MRs awaiting my review (reviewState UNREVIEWED).
    review = data['reviewRequestedMergeRequests']['nodes']
    rev = sum(
        1 for mr in review
        for r in mr['reviewers']['nodes']
        if r['username'] == me and r['mergeRequestInteraction']['reviewState'] == 'UNREVIEWED'
    )
    # Approved: open MRs *I authored* that someone actually approved → ready for me
    # to merge. Deliberately NOT the 'approved' boolean: that is true whenever the
    # project requires 0 approvals, which is every project on gitlab.com — it would
    # report all my open SaaS MRs as ready to merge. approvedBy is the real signal,
    # and on the internal instance the two agree exactly.
    mine = data['authoredMergeRequests']['nodes']
    appr = sum(1 for mr in mine if (mr.get('approvedBy') or {}).get('nodes'))
    # Chg: open MRs I authored that a reviewer returned with changes requested.
    chg = sum(
        1 for mr in mine
        if any(r['mergeRequestInteraction']['reviewState'] == 'REQUESTED_CHANGES'
               for r in mr['reviewers']['nodes'])
    )
    print(rev, appr, chg)
except Exception:
    pass
" 2>/dev/null
}

# Query every configured host, then sum. Each host's counts are cached in their own
# component file ($MR_CACHE.<id>) and the *sum* of the enabled ones lands in
# $MR_CACHE. Keeping components separate is what makes a half-outage honest: a host
# that fails this round keeps its last-good numbers instead of silently subtracting
# itself from the bar. Echoes "rev appr chg"; returns 1 when no host has any data.
#
# $MR_CACHE stays exactly three integers — `left` reads it with `read -r rev appr chg`,
# so a fourth field would land inside chg. Per-host detail belongs in the components.
_refresh_mr_cache() {
  local _h _r _a _c _rev=0 _appr=0 _chg=0 _have=0
  mkdir -p "$(dirname "$MR_CACHE")"
  for _h in $GITLAB_HOSTS; do
    read -r _r _a _c <<< "$(_fetch_mr_counts "$_h")"
    if [[ ${_r:-} =~ ^[0-9]+$ && ${_a:-} =~ ^[0-9]+$ && ${_c:-} =~ ^[0-9]+$ ]]; then
      printf '%s %s %s\n' "$_r" "$_a" "$_c" > "$MR_CACHE.$_h.tmp" \
        && mv -f "$MR_CACHE.$_h.tmp" "$MR_CACHE.$_h"
    fi
  done
  # Sum only the hosts that are configured *now*, so a decommissioned instance's
  # stale component stops counting the moment its creds leave the keyring.
  for _h in $GITLAB_HOSTS; do
    [[ -f "$MR_CACHE.$_h" ]] || continue
    read -r _r _a _c < "$MR_CACHE.$_h"
    [[ ${_r:-} =~ ^[0-9]+$ && ${_a:-} =~ ^[0-9]+$ && ${_c:-} =~ ^[0-9]+$ ]] || continue
    _rev=$((_rev + _r)); _appr=$((_appr + _a)); _chg=$((_chg + _c)); _have=1
  done
  (( _have )) || return 1
  printf '%s %s %s\n' "$_rev" "$_appr" "$_chg" > "$MR_CACHE.tmp" \
    && mv -f "$MR_CACHE.tmp" "$MR_CACHE"
  printf '%s %s %s' "$_rev" "$_appr" "$_chg"
}

case "$mode" in
  left)
    # Three MR counts (reviews-waiting / approved-to-merge / changes-returned). The
    # source of truth is $MR_CACHE, refreshed by `tmux-sysstat --refresh-mr` on a
    # systemd --user timer (which CAN read the @u keyring). This status line runs in
    # the tmux server's context, which can NOT read the keyring, so it must not query
    # live — it just renders the cache. Fall back to a live query only when creds are
    # already in the env (an inline bwu'd shell without the timer set up).
    if [[ -f $MR_CACHE ]]; then
      read -r rev appr chg < "$MR_CACHE"
    else
      source "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/gl-load-creds"
      counts=""
      [[ -n ${GITLAB_HOSTS:-} ]] && command -v glab >/dev/null 2>&1 && counts="$(_refresh_mr_cache)"
      read -r rev appr chg <<< "$counts"
    fi
    [[ ${rev:-} =~ ^[0-9]+$ && ${appr:-} =~ ^[0-9]+$ && ${chg:-} =~ ^[0-9]+$ ]] || { rev='?'; appr='?'; chg='?'; }

    compute_win

    # MR(Rev): 0 → green, anything else (including "?") → red.
    if [[ $rev == "0" ]]; then
      rev_col='#[fg=green]'
    else
      rev_col='#[fg=red,bold]'
    fi
    out="${rev_col}MR(Rev):${rev}${RESET}"

    # MR(Approved): MRs I've cleared, waiting to merge. >0 → cyan (go merge),
    # 0 → green, "?" (fetch failed) → red.
    if   [[ $appr == "?" ]]; then appr_col='#[fg=red,bold]'
    elif [[ $appr == "0" ]]; then appr_col='#[fg=green]'
    else                          appr_col='#[fg=cyan,bold]'
    fi
    out+="  ${appr_col}MR(Approved):${appr}${RESET}"

    # MR(Chg): MRs reviewers returned to me requesting changes. >0 → red (act),
    # 0 → green, "?" (fetch failed) → red.
    if   [[ $chg == "0" ]]; then chg_col='#[fg=green]'
    else                         chg_col='#[fg=red,bold]'
    fi
    out+="  ${chg_col}MR(Chg):${chg}${RESET}"

    # BRIDGE: only meaningful on the dev-server (on the laptop open-url goes
    # straight to the Windows browser — no tunnel involved).
    if ! is_wsl; then
      if bridge_state; then out+="  #[fg=green]BRIDGE:up${RESET}"
      else                  out+="  #[fg=red,bold]BRIDGE:down${RESET}"
      fi
    fi

    # BAT: <30 → red, else green.
    if [[ -n $wbat && $wbat != "-" ]]; then
      if (( wbat < 30 )); then bat_col='#[fg=red,bold]'
      else                     bat_col='#[fg=green]'
      fi
      out+="  ${bat_col}BAT:${wbat}%${RESET}"
    fi
    printf '%s' "$out"
    ;;

  api)
    # The API chip alone: for the tests, and for a quick look from a shell.
    api_chip
    ;;

  disk)
    # Disk free (GB) for root and $HOME, colored by use% (high_bad: 80 warn /
    # 90 danger). On the dev-server $HOME is its own disk (/dev/sdb); on WSL it
    # usually shares /, so the two chips may show the same filesystem.
    printf '%s  %s' "$(disk_chip / /)" "$(disk_chip "$HOME" '~')"
    ;;

  --refresh-mr)
    # Refresh $MR_CACHE from a keyring-possessing context (the systemd --user timer).
    # Only writes a host's component on a clean numeric fetch, so a transient failure
    # leaves that host's last good value in place rather than blanking the bar. glab
    # needs the mise shims on PATH — the unit's drop-in provides them.
    source "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/gl-load-creds"
    _refresh_mr_cache >/dev/null || exit 1
    ;;

  right|*)
    compute_win

    # --- WSL CPU% (cross-tick /proc/stat diff) ---
    read -r _ u n s i io irq sirq st _ < /proc/stat
    busy=$((u + n + s + irq + sirq + st))
    total=$((busy + i + io))
    lcpu=0
    if [[ -f $WSL_PREV ]]; then
      read -r pbusy ptotal < "$WSL_PREV"
      db=$((busy - pbusy))
      dt=$((total - ptotal))
      (( dt > 0 )) && lcpu=$((db * 100 / dt))
    fi
    echo "$busy $total" > "$WSL_PREV"

    # --- WSL free memory (GB) ---
    lfree=$(awk '/MemAvailable/ {printf "%.1f", $2/1048576}' /proc/meminfo)

    # CPU: <50 green, 50-79 yellow, >=80 red.
    wcpu_col=$(color_for "${wcpu:-0}" 50 80 high_bad)
    lcpu_col=$(color_for "${lcpu:-0}" 50 80 high_bad)

    # Free RAM: <1G → red, else green (integer GB comparison).
    wfree_int=${wfree%.*}
    lfree_int=${lfree%.*}
    if (( ${wfree_int:-0} < 1 )); then wfree_col='#[fg=red,bold]'; else wfree_col='#[fg=green]'; fi
    if (( ${lfree_int:-0} < 1 )); then lfree_col='#[fg=red,bold]'; else lfree_col='#[fg=green]'; fi

    if is_wsl; then
      printf '%sW%s%%%s/%s%sG%s  %sL%s%%%s/%s%sG%s' \
        "$wcpu_col" "$wcpu" "$RESET" \
        "$wfree_col" "$wfree" "$RESET" \
        "$lcpu_col" "$lcpu" "$RESET" \
        "$lfree_col" "$lfree" "$RESET"
    else
      # Dev-server: the local machine's CPU/mem (no Windows host to contrast), then API.
      printf '%s%s%%%s/%s%sG%s  %s' \
        "$lcpu_col" "$lcpu" "$RESET" \
        "$lfree_col" "$lfree" "$RESET" \
        "$(api_chip)"
    fi
    ;;
esac
