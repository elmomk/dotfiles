#!/usr/bin/env bash
# git-secret-wipe — remove git-secret revealed PLAINTEXT and the ephemeral GPG
# key. Meant to run at session/shutdown (see the git-secret-wipe.service unit)
# and is safe to run by hand. Never fails its caller — shutdown must proceed.
#
# The plaintext-removal logic is delegated to the configs repo's own cleaner
# (scripts/clean-secrets-all-worktrees.sh, falling back to clean-decrypt-secret.sh)
# so there is a single source of truth for "what counts as a revealed secret".
#
# Usage:  git-secret-wipe [-n|--dry-run] [REPO ...]     # default: ~/work/git/configs
#   -n, --dry-run   preview what would be removed; delete nothing.

set -uo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

log() { printf 'git-secret-wipe: %s\n' "$*"; }

DRY=0
REPOS=()
for a in "$@"; do
  case "$a" in
    -n|--dry-run) DRY=1 ;;
    -h|--help)
      printf 'Usage: git-secret-wipe [-n|--dry-run] [REPO ...]\n'
      printf '  Remove git-secret revealed plaintext (via each repo'\''s own cleaner)\n'
      printf '  and the ephemeral GPG keyring. Default repo: ~/work/git/configs.\n'
      printf '  -n, --dry-run   preview only; delete nothing.\n'
      exit 0 ;;
    -*) log "unknown option: $a (try --help)"; exit 2 ;;
    *)  REPOS+=("$a") ;;
  esac
done
[[ ${#REPOS[@]} -eq 0 ]] && REPOS=("$HOME/work/git/configs")
[[ $DRY -eq 1 ]] && log "DRY-RUN — nothing will be deleted"

# 1. Remove (or preview) revealed plaintext.
for repo in "${REPOS[@]}"; do
  if [[ ! -e $repo/.git ]]; then
    log "skip (not a git repo): $repo"
    continue
  fi

  if [[ $DRY -eq 1 ]]; then
    if ! command -v git-secret >/dev/null 2>&1; then
      log "git-secret not installed — would skip $repo"
      continue
    fi
    log "would clean revealed secrets in $repo:"
    present=0 total=0
    # while-loop reads from process substitution → runs in this shell, counters persist
    while IFS= read -r p; do
      [[ -z $p ]] && continue
      total=$((total + 1))
      if [[ -e $repo/$p ]]; then
        present=$((present + 1))
        printf '    rm %s\n' "$p"
      fi
    done < <(cd "$repo" && git secret list 2>/dev/null)
    log "  $present of $total registered secrets present (would be removed)"
  else
    cleaner="$repo/scripts/clean-secrets-all-worktrees.sh"
    [[ -f $cleaner ]] || cleaner="$repo/scripts/clean-decrypt-secret.sh"
    if [[ -f $cleaner ]]; then
      log "cleaning revealed secrets in $repo via $(basename "$cleaner")"
      ( cd "$repo" && bash "$cleaner" ) || log "cleaner returned non-zero in $repo (continuing)"
    else
      log "no cleaner script in $repo — skipping plaintext wipe"
    fi
  fi
done

# 2. Destroy (or preview) the ephemeral GPG keyring. tmpfs clears on reboot
#    anyway, but wipe it on a clean shutdown/logout too.
eph="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gnupg-ephemeral"
if [[ -d $eph ]]; then
  if [[ $DRY -eq 1 ]]; then
    log "would kill agent + rm -rf ephemeral GNUPGHOME $eph"
  else
    log "removing ephemeral GNUPGHOME $eph"
    gpgconf --homedir "$eph" --kill all >/dev/null 2>&1 || true
    rm -rf -- "$eph" || log "failed to remove $eph"
  fi
fi

log "done"
exit 0
